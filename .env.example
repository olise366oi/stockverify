# StockVerify 环境变量示例
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，不会提交。

# 服务监听端口（默认 3000）
PORT=3000

# JWT 签名密钥【生产环境必填】
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 要求：至少 32 字符的随机字符串
# 若 NODE_ENV=production 且未设置，服务将拒绝启动
JWT_SECRET=

# 运行环境（production 时强制校验 JWT_SECRET）
NODE_ENV=development

# CORS 白名单（逗号分隔多个来源；留空则仅允许同源 + 开发环境 localhost）
# 示例：CORS_ORIGINS=https://stockverify.example.com,https://admin.example.com
CORS_ORIGINS=

# SQLite 数据库文件路径（默认 data/inventory.db，相对于项目根目录）
DATABASE_PATH=data/inventory.db
